
# Application
NODE_ENV=development
PORT=5995
APP_URL=http://localhost:5995

# Database (Postgres + Prisma)
# Ví dụ: postgresql://user:password@localhost:5432/dbname?schema=public
DATABASE_URL=
# Shadow DB (optional, used by some Prisma flows)
SHADOW_DATABASE_URL=

# Auth / JWT
JWT_SECRET=
# Expiry formats supported: "3600s", "7d" etc.
JWT_EXPIRES_IN=7d

# Redis (optional, for caching/session)
REDIS_URL=redis://localhost:6379

# Email / SMTP (for sending emails)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="no-reply@example.com"

# File storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Third-party services
SENTRY_DSN=
STRIPE_SECRET_KEY=

# Optional: frontend client URL (CORS, redirects)
CLIENT_URL=http://localhost:3000

# Notes:
# - Replace placeholders with real values in production.
# - Keep secrets out of version control; commit only this example file.

